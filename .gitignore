# ==============================================================================
# Domain-Aware JSON Banking Compiler Validator - .gitignore
# ==============================================================================

# Compiled Binaries
banking_validator
banking_validator.exe
*.exe
*.out
*.app

# Object Files & Intermediate Build Artifacts
*.o
*.obj
src/*.o
src/*.obj

# Generated Flex & Bison Parser/Lexer Code (Re-generated by Makefile)
src/json_parser.tab.c
src/json_parser.tab.h
src/lex.yy.c
src/json_parser.output

# Python Bytecode & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Editor & IDE Directories
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files & Logs
.DS_Store
Thumbs.db
desktop.ini
*.log
tmp/
